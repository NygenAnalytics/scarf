# R2 credentials for s3:// URIs in tests/r2_profile.py
#   cp .env.example .env
#
# Open existing Zarr on R2:
#   uv run python -m tests.r2_profile --uri s3://bucket/prefix/data.zarr
#
# Create from h5ad or Cell Ranger MTX, then run workflow:
#   uv run python -m tests.r2_profile --from-h5ad data.h5ad --uri s3://bucket/prefix/data.zarr
#   uv run python -m tests.r2_profile --from-mtx filtered_feature_bc_matrix/ --uri s3://bucket/prefix/data.zarr

SCARF_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
SCARF_R2_ACCESS_KEY_ID=
SCARF_R2_SECRET_ACCESS_KEY=
