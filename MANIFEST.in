recursive-exclude * __pycache__
recursive-exclude * *.pyc
recursive-exclude * *.pyo
exclude .gitignore
exclude .gitattribute
exclude .readthedocs.yml
exclude Dockerfile
prune scarf_toolkit.egg-info
prune docs
prune tests
prune profiling
prune scripts
prune .circleci
prune .github
include VERSION
include README.md
graft bin
